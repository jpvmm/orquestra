# Copy to $VIGIA_BASE/webhook.env (default ~/.orquestra/vigia/webhook.env) and run: chmod 600 webhook.env
# Parsed as KEY=value lines; never executed. Without this file Vigia only logs locally (not an error).

# URL of the webhook that wakes your orchestrator (e.g. a Grok Bot routine with a webhook trigger)
VIGIA_WEBHOOK_URL=https://example.invalid/your-webhook-url

# Secret sent with each POST. With the default header the value becomes "Bearer <key>".
VIGIA_WEBHOOK_KEY=replace-with-your-key

# Optional: send the key raw in a different header instead of Authorization
# VIGIA_WEBHOOK_HEADER=Authorization
