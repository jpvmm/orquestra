#!/usr/bin/env python3
"""vigia-run: supervise a headless Claude Code or Codex CLI run in the background.

Usage:
  vigia-run --tool claude|codex --task-dir DIR --name NAME [--stall-min 10] [--max-min 20]
            [--max-turns-hint N] [--max-files N] [--protect-tests] [--loop-repeat 3]
            [--cwd DIR] [--task "short description"] [--prompt-file PATH] [--foreground]
            -- <full claude/codex command>

Next to the status it writes <name>.prompt.md (task, tool, model, rule files, system prompt additions and the
full prompt the agent received) and <name>.conversation.md (Orquestra -> agent, agent messages, one line per
tool call, subagents and the final reply). Notifies (vigia-notify) on start, on each alert/detection and at the end.

--max-min is wall-clock time: it also counts time the machine spent suspended. The supervisor touches its
status.json every poll (heartbeat), so the watchdog in vigia-status / vigia-run can tell when it stopped watching.
VIGIA_WEBHOOK_ENV at launch is stored in the status (per-run webhook; "" = muted).

Returns immediately (the supervisor is detached and survives the end of the shell/turn) and prints
a JSON object with the status path. Exit 0 = started; 2 = bad usage; 3 = active-run cap reached;
4 = name already used in this task-dir; 5 = command not found.

Paths: state lives in $VIGIA_BASE (default $ORQUESTRA_HOME/vigia, default ~/.orquestra/vigia);
per-run files live in <task-dir>/runs/.
"""
import argparse, ctypes, json, os, re, shlex, signal, shutil, subprocess, sys, time

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import vigia_lib as V
import vigia_comms as C

POLL = float(os.environ.get("VIGIA_POLL_SEC", "3"))
CPU_TICKS_BUSY = int(os.environ.get("VIGIA_CPU_TICKS", "15"))  # CPU ticks (1/100 s) per poll that count as "working"
KILL_GRACE = float(os.environ.get("VIGIA_KILL_GRACE", "10"))
# no new bytes for STALL_CPU_MULT x stall-min = stalled even with CPU (a live process spinning without producing anything)
STALL_CPU_MULT = float(os.environ.get("VIGIA_STALL_CPU_MULT", "3"))
SUSPEND_SEC = float(os.environ.get("VIGIA_SUSPEND_SEC", "60"))  # wall clock ran this much ahead of monotonic = box suspended


def fail(msg, code):
    print(f"vigia-run: {msg}", file=sys.stderr)
    sys.exit(code)


def parse():
    argv = sys.argv[1:]
    if "--" not in argv:
        fail("missing '--' before the command. E.g.: vigia-run --tool claude --task-dir D --name N -- claude -p ...", 2)
    i = argv.index("--")
    ours, cmd = argv[:i], argv[i + 1:]
    p = argparse.ArgumentParser(prog="vigia-run")
    p.add_argument("--tool", required=True, choices=["claude", "codex", "other"])
    p.add_argument("--task-dir", required=True)
    p.add_argument("--name", required=True)
    p.add_argument("--stall-min", type=float, default=10)
    p.add_argument("--max-min", type=float, default=20)
    p.add_argument("--max-turns-hint", type=int, default=0,
                   help="expected tool calls: above this is an alert, above 2x is a loop (growing scope)")
    p.add_argument("--max-files", type=int, default=0, help="number of distinct edited files above which it counts as growing scope (loop)")
    p.add_argument("--protect-tests", action="store_true")
    p.add_argument("--loop-repeat", type=int, default=3, help="repetitions of the same error/cycle that count as a loop")
    p.add_argument("--cwd", default=None)
    p.add_argument("--foreground", action="store_true", help="do not detach (debug)")
    p.add_argument("--task", default=None, help="short task description (goes into the status, notifications and prompt.md)")
    p.add_argument("--role", default=None, help="the run's real role (plan|review|implement|lead): decides the Claude-limit follow-up")
    p.add_argument("--output", default=None, help="expected result file; a Codex fallback of a Claude review writes there")
    p.add_argument("--prompt-file", default=None,
                   help="file holding the prompt (when the prompt comes from stdin/'-', or to record the full prompt)")
    a = p.parse_args(ours)
    if not cmd:
        fail("empty command after '--'", 2)
    if not re.fullmatch(r"[A-Za-z0-9._-]{1,80}", a.name):
        fail("--name only accepts letters, digits, dot, _ and - (up to 80)", 2)
    a.cmd = cmd
    a.task_dir = os.path.abspath(a.task_dir)
    a.cwd = os.path.abspath(a.cwd or os.getcwd())
    a.prompt_file = os.path.abspath(a.prompt_file) if a.prompt_file else None
    a.task = re.sub(r"\s+", " ", a.task).strip()[:300] if a.task else None
    return a


# ======================= event analysis =======================

class Analyzer:
    """Reads events (claude stream-json, codex --json, hook lines) and detects loops."""

    def __init__(self, a):
        self.a = a
        self.error_counts = {}         # signature -> count
        self.cycles = {}        # edit/test cycle signature -> count
        self.edits_since_test = []
        self.files = set()
        self.tools = {}         # tool_use_id -> (name, input)
        self.turn_count = 0
        self.calls = 0
        self.loop = None        # reason
        self.alerts = []
        self.last_msg = None
        self.result = None
        self.session_id = None
        self.stream_claude = False
        self.stream_codex = False   # saw codex exec --json events (main source; hooks only complement)
        self.codex_pending = []        # hook PostToolUse with no matching --json item yet: [t, ev]
        self.codex_json = []        # --json items that arrived before the hook: [t, cmd, paths]
        self.last_error = None
        self.model = None
        self.conv = None            # C.Transcript (conversation.md), set by the supervisor

    def _conv(self, kind, text, who=None):
        if self.conv is not None:
            try:
                self.conv.add(kind, text, who)
            except Exception:
                pass

    # --- helpers
    def _alert(self, txt):
        if V.ALERT_RE.search(txt or ""):
            m = V.normalize(txt, 200)
            if m not in self.alerts and len(self.alerts) < 10:
                self.alerts.append(m)

    def _error(self, origin, msg_text):
        self.last_error = str(msg_text)[-300:]
        self._alert(msg_text)
        sig = V.h(origin, V.normalize(msg_text))
        self.error_counts[sig] = self.error_counts.get(sig, 0) + 1
        if self.error_counts[sig] >= self.a.loop_repeat and not self.loop:
            self.loop = f"same error {self.error_counts[sig]}x ({origin}): {str(msg_text).strip()[:200]}"

    def _edit(self, path, file_content=""):
        if not path:
            return
        self.files.add(path)
        self.edits_since_test.append(V.h(path, file_content))
        if self.a.protect_tests and V.is_test(path) and not self.loop:
            self.loop = f"touched a protected test file: {path}"
        if self.a.max_files and len(self.files) > self.a.max_files and not self.loop:
            self.loop = f"growing scope: {len(self.files)} files edited (> --max-files {self.a.max_files})"

    def _shell(self, cmd):
        for p in V.shell_test_writes(cmd):
            self._edit(p, "shell:" + cmd)

    def _test(self, cmd, output, failed):
        sig = V.h(sorted(self.edits_since_test), V.normalize(cmd, 200), V.normalize(output, 600), failed)
        self.edits_since_test = []
        self.cycles[sig] = self.cycles.get(sig, 0) + 1
        if self.cycles[sig] >= self.a.loop_repeat and not self.loop:
            self.loop = f"identical edit/test cycle {self.cycles[sig]}x with no progress ({cmd[:120]})"

    def _tool_call(self):
        self.calls += 1
        n = self.a.max_turns_hint
        if n:
            if self.calls > n and f"exceeded max-turns-hint ({n})" not in self.alerts:
                self.alerts.append(f"exceeded max-turns-hint ({n})")
            if self.calls > 2 * n and not self.loop:
                self.loop = f"growing scope: {self.calls} tool calls (> 2x --max-turns-hint {n})"

    # --- claude stream-json
    def claude(self, ev):
        t = ev.get("type")
        if t == "system":
            self.stream_claude = True
            if ev.get("subtype") == "init":
                self.session_id = ev.get("session_id")
                self.model = self.model or ev.get("model")
            else:
                self._alert(json.dumps(ev, ensure_ascii=False)[:500]) if ev.get("subtype") in ("api_retry", "error") else None
        elif t == "assistant":
            self.stream_claude = True
            self.turn_count += 1
            who = "subagent" if ev.get("parent_tool_use_id") else None
            if not self.model and (ev.get("message") or {}).get("model"):
                self.model = ev["message"]["model"]
            for c in (ev.get("message") or {}).get("content") or []:
                if c.get("type") == "tool_use":
                    name, inp = c.get("name"), c.get("input") or {}
                    self.tools[c.get("id")] = (name, inp)
                    if name in ("Task", "Agent") and self.conv is not None:
                        self.conv.subagent_call(c.get("id"), inp.get("subagent_type"), inp.get("description"), inp.get("prompt"))
                    else:
                        self._conv("tool", C.tool_line(name, inp), who)
                    self._tool_call()
                    if name in ("Edit", "Write", "MultiEdit", "NotebookEdit"):
                        self._edit(inp.get("file_path") or inp.get("notebook_path"),
                                   json.dumps(inp, sort_keys=True)[:5000])
                    elif name == "Bash":
                        self._shell(inp.get("command", ""))
                elif c.get("type") == "text" and c.get("text"):
                    if not who:
                        self.last_msg = c["text"]
                    self._conv("assistant", c["text"], who)
        elif t == "user":
            self.stream_claude = True
            for c in (ev.get("message") or {}).get("content") or [] if isinstance((ev.get("message") or {}).get("content"), list) else []:
                if c.get("type") != "tool_result":
                    continue
                content = c.get("content")
                if isinstance(content, list):
                    content = "\n".join(x.get("text", "") for x in content if isinstance(x, dict))
                name, inp = self.tools.get(c.get("tool_use_id"), (None, {}))
                if name in ("Task", "Agent"):
                    self._conv("sub_result", content, (inp or {}).get("subagent_type") or "subagent")
                if c.get("is_error"):
                    self._error(f"tool:{name}", content)
                    self._conv("error", f"{name}: {str(content)[:300]}")
                if name == "Bash" and V.TEST_CMD_RE.search(inp.get("command", "")):
                    self._test(inp.get("command", ""), content, bool(c.get("is_error")))
        elif t == "rate_limit_event":
            info = ev.get("rate_limit_info") or {}
            if info.get("status") not in (None, "allowed", "allowed_warning"):
                a = f"Claude rate limit: status={info.get('status')} type={info.get('rateLimitType')}"
                if a not in self.alerts:
                    self.alerts.append(a)
        elif t == "result":
            self.stream_claude = True
            self.result = ev
            self.session_id = ev.get("session_id") or self.session_id
            if ev.get("is_error"):
                self._alert(str(ev.get("result")) + " " + str(ev.get("subtype")))
            if ev.get("result"):
                self.last_msg = ev.get("result")
                self._conv("final", ev.get("result"))
            elif ev.get("is_error"):
                self._conv("error", f"{ev.get('subtype')}: {str(ev.get('result') or '')[:300]}")

    # --- Codex hooks: --json already carries commands/edits/errors; the hook only adds what --json does not show
    def codex_hook(self, ev):
        event_name, name = ev.get("hook_event_name"), ev.get("tool_name")
        if event_name == "SessionStart" and ev.get("model"):
            self.model = self.model or ev.get("model")
        if event_name == "SubagentStop":
            self._conv("sub_result", ev.get("last_message") or "(no message)", ev.get("agent_type") or "subagent")
        if event_name == "PreToolUse" and ev.get("denied"):
            # a denied apply_patch does not show up in --json: count it as an attempt to touch a test
            self._edit(ev.get("path"), "denied")
            return
        if event_name == "PostToolUse" and name in ("Bash", "apply_patch"):
            # Codex 0.166 --json omits commands blocked by the sandbox; hold the hook event for a while and,
            # if no --json item matches, count it from the hook (see codex_reconcile)
            self.codex_pending.append([time.monotonic(), ev])
            for k, (_t, cmd, paths) in enumerate(self.codex_json):
                if self._codex_match(cmd=cmd, paths=paths):
                    del self.codex_json[k]
                    break
            return
        if self.stream_codex:
            return
        if event_name == "PostToolUse":  # no --json: other tools count as calls
            self._tool_call()
            if name == "apply_patch":
                for p in ev.get("files") or []:
                    self._edit(p, ev.get("edit_sig", ""))
            elif name == "Bash":
                cmd = (ev.get("tool_input") or {}).get("command", "")
                self._shell(cmd)
                if V.TEST_CMD_RE.search(cmd):
                    self._test(cmd, ev.get("output", ""), None)
        elif event_name == "Stop" and ev.get("last_message"):
            self.last_msg = ev.get("last_message")

    def _codex_item(self, cmd=None, paths=None):
        if not self._codex_match(cmd=cmd, paths=paths):
            now_local = time.monotonic()
            self.codex_json = [x for x in self.codex_json if now_local - x[0] < 60][-50:] + [[now_local, cmd, paths]]

    def _codex_match(self, cmd=None, paths=None):
        """Remove from the hook queue the PostToolUse that matches a --json item. True if found."""
        for k, (_t, h) in enumerate(self.codex_pending):
            if cmd is not None and h.get("tool_name") == "Bash":
                hc = (h.get("tool_input") or {}).get("command", "")
                try:
                    parts = shlex.split(cmd)
                except ValueError:
                    parts = [cmd]
                if hc and (hc == cmd or (parts and parts[-1] == hc)):
                    del self.codex_pending[k]; return True
            if paths is not None and h.get("tool_name") == "apply_patch":
                hp = h.get("files") or []
                if hp and all(any(q == x or q.endswith("/" + x.lstrip("./")) for q in paths) for x in hp):
                    del self.codex_pending[k]; return True

    def codex_reconcile(self, end=False, wait_sec=10):
        """Hook PostToolUse with no --json item after `wait_sec` s: count it here (call, test write via
        shell, test cycle and error). Without --json, everything comes through here."""
        now_local = time.monotonic()
        remainder = []
        for t, h in self.codex_pending:
            if not end and self.stream_codex and now_local - t < wait_sec:
                remainder.append([t, h]); continue
            self._tool_call()
            name, output = h.get("tool_name"), h.get("output", "")
            if name == "Bash":
                cmd = (h.get("tool_input") or {}).get("command", "")
                self._shell(cmd)
                if V.TEST_CMD_RE.search(cmd):
                    self._test(cmd, output, None)
                if self.stream_codex:  # missing from --json: in 0.166 this is a command blocked by the sandbox
                    self._error("command-hook", f"{cmd}\n{output[-800:]}")
            elif name == "apply_patch":
                if self.stream_codex:  # patch that never became a file_change: it failed
                    self._error("apply_patch", output or " ".join(h.get("files") or []))
                else:
                    for p in h.get("files") or []:
                        self._edit(p, h.get("edit_sig", ""))
        self.codex_pending = remainder

    # --- Claude hooks (used for loop detection only when there is no stream-json)
    def hook(self, ev):
        event_name = ev.get("hook_event_name")
        if ev.get("origin") == "codex":
            return self.codex_hook(ev)
        if self.stream_claude:
            return
        if event_name == "PostToolUse" or event_name == "PostToolUseFailure":
            name, inp = ev.get("tool_name"), ev.get("tool_input") or {}
            self._tool_call()
            if name in ("Edit", "Write", "MultiEdit", "NotebookEdit"):
                self._edit(inp.get("file_path") or inp.get("notebook_path"), ev.get("edit_sig", ""))
            if name == "Bash":
                self._shell(inp.get("command", ""))
                if V.TEST_CMD_RE.search(inp.get("command", "")):
                    self._test(inp.get("command", ""), ev.get("output", ""), event_name == "PostToolUseFailure")
            if event_name == "PostToolUseFailure":
                self._error(f"tool:{name}", ev.get("error", ""))
        elif event_name == "PreToolUse" and ev.get("denied"):
            self._edit(ev.get("path"), "denied")
        elif event_name == "StopFailure":
            self._alert(str(ev.get("error", "")) + " " + str(ev.get("matcher", "")))
        elif event_name == "SubagentStop":
            self._conv("sub_result", ev.get("last_message") or "(no message)", ev.get("agent_type") or "subagent")
        elif event_name == "Stop" and ev.get("last_message") and not self.last_msg:
            self.last_msg = ev.get("last_message")

    # --- codex exec --json
    def codex(self, ev):
        t = ev.get("type", "")
        if t:
            self.stream_codex = True
        if t == "thread.started":
            self.session_id = ev.get("thread_id")
        elif t == "turn.started":
            self.turn_count += 1
        elif t == "turn.failed":
            self._error("turn.failed", json.dumps(ev.get("error"), ensure_ascii=False))
            self._conv("error", json.dumps(ev.get("error"), ensure_ascii=False)[:300])
        elif t == "error":
            self._error("error", ev.get("message", ""))
            self._conv("error", str(ev.get("message", ""))[:300])
        elif t == "item.started":
            it = ev.get("item") or {}
            if it.get("type") in ("command_execution", "file_change", "mcp_tool_call", "web_search"):
                self._tool_call()
            if it.get("type") == "command_execution":
                self._shell(it.get("command", ""))
        elif t == "item.completed":
            it = ev.get("item") or {}
            ty = it.get("type")
            if ty == "agent_message":
                self.last_msg = it.get("text")
                self._conv("assistant", it.get("text"))
            elif ty == "file_change":
                self._conv("tool", "edit: " + ", ".join(f"{ch.get('kind', '')} {ch.get('path', '')}".strip()
                                                       for ch in it.get("changes") or [])[:200])
                for ch in it.get("changes") or []:
                    self._edit(ch.get("path"), ch.get("kind", ""))
                self._codex_item(paths=[ch.get("path", "") for ch in it.get("changes") or []])
            elif ty == "command_execution":
                cmd, out, ec = it.get("command", ""), it.get("aggregated_output", ""), it.get("exit_code")
                self._conv("tool", C.tool_line("shell", {"command": cmd}) + (f" (exit {ec})" if ec not in (0, None) else ""))
                self._codex_item(cmd=cmd)
                failed = ec not in (0, None) or it.get("status") == "failed"
                if failed:
                    self._error("command", f"{cmd}\n{out[-800:]}")
                if V.TEST_CMD_RE.search(cmd):
                    self._test(cmd, out[-2000:], failed)
            elif ty == "error":
                if "--dangerously-bypass-hook-trust" not in str(it.get("message", "")):  # our own warning, not an error
                    self._error("item.error", it.get("message", ""))
            elif ty == "mcp_tool_call" and it.get("status") == "failed":
                self._error("mcp", json.dumps(it.get("error"), ensure_ascii=False))
            if ty == "mcp_tool_call":
                self._conv("tool", f"mcp {it.get('server', '')}.{it.get('tool', '')}" + (" (failed)" if it.get("status") == "failed" else ""))
            elif ty == "web_search":
                self._conv("tool", C.tool_line("web_search", {"query": it.get("query", "")}))
            elif ty and ty not in ("agent_message", "file_change", "command_execution", "reasoning", "error", "todo_list"):
                # collaboration/subagents and new item types: one line with whatever is visible
                txt = it.get("prompt") or it.get("text") or it.get("description") or ""
                who = "subagent" if re.search(r"agent|collab|spawn|delegat", ty) else None
                self._conv("sub_call" if who else "tool", f"{ty}: {C.preview(txt, 300)}".rstrip(": "))

    def rec(self, txt, origin):
        txt = txt.strip()
        if not txt:
            return
        try:
            ev = json.loads(txt)
        except Exception:
            if origin == "events":
                self._alert(txt)
            return
        if not isinstance(ev, dict):
            return
        if origin == "hooks":
            self.hook(ev)
        elif self.a.tool == "codex" or "." in str(ev.get("type", "")) or ev.get("type") == "error":
            self.codex(ev)
        else:
            self.claude(ev)


class Tailer:
    """Reads new lines from a file incrementally."""

    def __init__(self, path):
        self.path, self.pos, self.buf = path, 0, ""

    def file_size(self):
        try:
            return os.path.getsize(self.path)
        except OSError:
            return 0

    def new_lines(self):
        try:
            with open(self.path, "r", errors="replace") as f:
                f.seek(self.pos)
                data = f.read(4 * 1024 * 1024)
                self.pos = f.tell()
        except OSError:
            return []
        self.buf += data
        *lines, self.buf = self.buf.split("\n")
        return lines


# ======================= Codex hooks (this run only) =======================

CODEX_HOOK = os.path.join(os.path.dirname(os.path.abspath(__file__)), "vigia-codex-hook")
CODEX_OPTS_WITH_VALUE = {"-c", "--config", "-m", "--model", "-p", "--profile", "-s", "--sandbox", "-C", "--cd",
                       "-i", "--image", "--enable", "--disable", "-a", "--ask-for-approval", "--add-dir",
                       "--remote", "--local-provider", "--color", "-o", "--output-last-message", "--output-schema"}
CODEX_EVENTS = (("SessionStart", False), ("PreToolUse", True), ("PostToolUse", True),
                 ("Stop", False), ("SubagentStop", False))


def codex_with_hooks(cmd):
    """If cmd is `codex ... exec ...`, return (cmd with Vigia's -c hooks.* + --dangerously-bypass-hook-trust
    right after `exec`, True). Nothing is written to ~/.codex. Disable with VIGIA_CODEX_HOOKS=0."""
    if os.environ.get("VIGIA_CODEX_HOOKS", "1") == "0" or os.path.basename(cmd[0]) not in ("codex", "codex.js"):
        return cmd, False
    i = next((k for k in range(1, len(cmd)) if cmd[k] in ("exec", "e") and cmd[k - 1] not in CODEX_OPTS_WITH_VALUE), None)
    if i is None:
        return cmd, False
    extra = []
    if "--dangerously-bypass-hook-trust" not in cmd:
        extra.append("--dangerously-bypass-hook-trust")  # without this Codex silently skips untrusted hooks
    for ev, with_matcher in CODEX_EVENTS:
        m = 'matcher="*",' if with_matcher else ""
        extra += ["-c", f'hooks.{ev}=[{{{m}hooks=[{{type="command",command="{CODEX_HOOK}",timeout=10}}]}}]']
    return cmd[:i + 1] + extra + cmd[i + 1:], True


# ======================= supervisor =======================

def prepare_prompt(a, paths, started):
    """Extract prompt/model/system prompt from the command, write <run>.prompt.md (redacted) and return the info."""
    try:
        info = C.extract_prompt(a.tool, a.cmd, a.cwd, a.prompt_file)
    except Exception as e:
        info = {"model": None, "prompt": None, "prompt_source": None, "system": [], "reply_file": None,
                "notes": [f"could not extract the prompt: {type(e).__name__}: {e}"]}
    rules = []
    try:
        rules = C.rules_files(a.cwd)
        C.write_atomic(paths["prompt"], C.render_prompt_md(a.name, a.task, a.tool, info, a.cwd, a.cmd, rules, started))
    except Exception as e:
        info.setdefault("notes", []).append(f"could not write prompt.md: {type(e).__name__}")
    info["rules"] = rules
    return info


def supervise(a, paths, key, notifier=None):
    cmd_original = a.cmd
    codex_hooks_on = False
    if a.tool == "codex":
        a.cmd, codex_hooks_on = codex_with_hooks(a.cmd)
    started = V.now_iso()
    info = prepare_prompt(a, paths, started)
    st = {
        "name": a.name, "tool": a.tool, "state": "running", "task_dir": a.task_dir, "cwd": a.cwd,
        "task": a.task, "model": info.get("model"), "prompt_preview": C.preview(C.redact(info.get("prompt") or "")) or None,
        "prompt_path": paths["prompt"], "prompt_source": info.get("prompt_source"), "rules_files": info.get("rules"),
        "system_prompt_additions": [k for k, _ in info.get("system") or []],
        "conversation_path": paths["conversation"], "reply_preview": None, "stopping": None,
        "cmd": cmd_original, "codex_hooks": codex_hooks_on, "supervisor_pid": os.getpid(), "pid": None, "pgid": None,
        "started_at": started, "ended_at": None, "exit_code": None, "last_event_at": None,
        "checked_at": None, "summary": "", "loop_reason": None, "alerts": [],
        "limits": {"stall_min": a.stall_min, "max_min": a.max_min, "max_turns_hint": a.max_turns_hint,
                   "max_files": a.max_files, "protect_tests": a.protect_tests, "loop_repeat": a.loop_repeat,
                   "role": a.role},
        "role": a.role, "output": os.path.abspath(a.output) if a.output else None,
        "relaunch_argv": relaunch_argv_from_environ(),
        "stats": {}, "kill": None, "paths": paths,
        # per-bot webhook: VIGIA_WEBHOOK_ENV at launch is stored here so notifications go to the same bot even
        # when another process sends them (e.g. vigia-status cleaning up a dead supervisor). None = default.
        "webhook_env": webhook_env_from_environ(),
    }

    conv = C.Transcript(paths["conversation"], a.name, a.task, a.tool, info.get("model"), info.get("prompt"), paths["prompt"])

    def save():
        st["checked_at"] = V.now_iso()
        try:
            if an is not None:
                if an.model and not st.get("model"):
                    st["model"] = conv.model = an.model
                    conv.dirty = True
            if conv.last_reply:
                st["reply_preview"] = C.preview(conv.last_reply)
            conv.flush()
        except Exception:
            pass
        with V.run_lock(paths["status"]):  # same lock as the watchdog: checking the mark and writing is atomic
            if (V.read_json(paths["status"]) or {}).get("watchdog"):
                return False  # the watchdog took over this run (the supervisor had stopped watching): do not overwrite
            V.write_json_atomic(paths["status"], C.redact_obj(st))
        return True

    def notify(event, state, prev=None, detail=None, dedupe_key=None):
        if notifier is not None:
            try:
                notifier.send(event, state, prev, detail, dedupe_key)
            except Exception:
                pass

    an = None

    # subreaper: orphaned descendants are re-parented here (so they can be tracked and killed even if they leave the group)
    try:
        ctypes.CDLL(None, use_errno=True).prctl(36, 1, 0, 0, 0)
    except Exception:
        pass

    term_state = {"signal": None}

    def on_sig(signum, _f):
        term_state["signal"] = signum
    signal.signal(signal.SIGTERM, on_sig)
    signal.signal(signal.SIGINT, on_sig)
    signal.signal(signal.SIGHUP, signal.SIG_IGN)

    env = dict(os.environ)
    env["PATH"] = env.get("PATH", "") + ":" + os.path.expanduser("~/.local/bin")  # fallback: default claude install dir
    env["VIGIA_HEARTBEAT"] = paths["hooks"]
    env["VIGIA_RUN"] = a.name
    env["VIGIA_PROTECT_TESTS"] = "1" if a.protect_tests else "0"

    ev_f = open(paths["events"], "ab")
    err_f = open(paths["stderr"], "ab")
    try:
        proc = subprocess.Popen(a.cmd, stdin=subprocess.DEVNULL, stdout=ev_f, stderr=err_f,
                                cwd=a.cwd, env=env, start_new_session=True)
    except Exception as e:
        st.update(state="failed", ended_at=V.now_iso(), exit_code=127, summary=f"could not start: {e}")
        save()
        return st
    ev_f.close(); err_f.close()
    pgid = proc.pid
    pstat = V.proc_stat(proc.pid) or {}
    st.update(pid=proc.pid, pgid=pgid, pid_start=pstat.get("start"))
    an = Analyzer(a)
    an.conv = conv
    save()
    notify("started", "running", "starting", dedupe_key="started")
    alerts_sent = set()
    ev_tail, hk_tail, err_tail = Tailer(paths["events"]), Tailer(paths["hooks"]), Tailer(paths["stderr"])
    t0 = time.monotonic()
    w0 = time.time()  # the cap (max-min) is wall-clock time: it also counts time the box was suspended
    w_prev, m_prev = w0, t0
    suspended = 0.0
    last_alive = last_byte = time.monotonic()
    st["last_event_at"] = V.now_iso()
    size_prev = (0, 0, 0)
    cpu_prev = None
    last_save = 0
    reason = None  # stalled|timeout|loop|killed
    rc = None

    while True:
        # reaper (we are a subreaper): reap zombies, keep the main child's exit code
        while True:
            try:
                p, s = os.waitpid(-1, os.WNOHANG)
            except ChildProcessError:
                break
            if p == 0:
                break
            if p == proc.pid:
                rc = os.waitstatus_to_exitcode(s)
        for ln in ev_tail.new_lines():
            an.rec(ln, "events")
        for ln in hk_tail.new_lines():
            an.rec(ln, "hooks")
        an.codex_reconcile()
        for ln in err_tail.new_lines():
            stderr_alert(an, a, ln)
        # box suspended (VM paused): monotonic time stops, wall clock jumps
        w_now, m_now = time.time(), time.monotonic()
        jump = (w_now - w_prev) - (m_now - m_prev)
        if jump > SUSPEND_SEC:
            suspended += jump
            st["suspended_sec"] = int(suspended)
            an.alerts.append(f"box suspended ~{int(jump // 60)} min during the run ({V.iso_from(w_prev)} -> "
                             f"{V.iso_from(w_now)}): nothing ran meanwhile; the wall-clock cap counts this time")
        w_prev, m_prev = w_now, m_now
        try:
            os.utime(paths["status"])  # supervisor heartbeat (the watchdog looks at the mtime)
        except OSError:
            pass

        sizes = (ev_tail.file_size(), hk_tail.file_size(), os.path.getsize(paths["stderr"]) if os.path.exists(paths["stderr"]) else 0)
        alive_pids, procs = V.members(pgid, [proc.pid])
        cpu = sum(procs[p]["cpu"] for p in alive_pids if p in procs)
        grew = sizes != size_prev
        busy = cpu_prev is not None and (cpu - cpu_prev) >= CPU_TICKS_BUSY
        if grew:
            st["last_event_at"] = V.now_iso()
            last_byte = time.monotonic()
        if grew or busy:
            last_alive = time.monotonic()
        size_prev, cpu_prev = sizes, cpu

        st["stats"] = {"turns": an.turn_count, "tool_calls": an.calls, "files_edited": len(an.files),
                       "bytes_events": sizes[0], "bytes_hooks": sizes[1], "bytes_stderr": sizes[2],
                       "cpu_sec": round(cpu / os.sysconf("SC_CLK_TCK"), 1), "processes": len(alive_pids),
                       "idle_sec": int(time.monotonic() - last_alive)}
        st["session_id"] = an.session_id
        st["alerts"] = an.alerts
        for al in an.alerts:
            if al not in alerts_sent:
                alerts_sent.add(al)
                save()
                notify("alert", "running", "running", al, "alert|" + V.h(al))

        if rc is not None:
            break
        if term_state["signal"]:
            reason = "killed"; st["summary"] = f"received signal {term_state['signal']} (vigia-stop?)"
        elif an.loop:
            reason = "loop"; st["loop_reason"] = an.loop; st["summary"] = "loop: " + an.loop
        elif time.time() - w0 > a.max_min * 60:
            reason = "timeout"; st["summary"] = f"exceeded {a.max_min:g} min of wall-clock time" + \
                (f" (box suspended ~{int(suspended // 60)} min meanwhile)" if suspended else "")
        elif time.monotonic() - last_alive > a.stall_min * 60:
            reason = "stalled"; st["summary"] = f"no new bytes and no CPU for {a.stall_min:g} min"
        elif time.monotonic() - last_byte > STALL_CPU_MULT * a.stall_min * 60:
            reason = "stalled"; st["summary"] = (f"no new bytes for {STALL_CPU_MULT * a.stall_min:g} min "
                                                 f"({STALL_CPU_MULT:g}x stall-min) even with CPU")
        if reason:
            # detected: notify now (killing + evidence still take a few seconds)
            st["stopping"] = {"reason": reason, "detail": st["summary"], "at": V.now_iso()}
            if save():  # False: the watchdog already took over and sent its own detected; just go on to the kill (idempotent)
                notify("detected", "running", "running", f"{reason}: {st['summary']}", "detected|" + reason)
            break
        if time.monotonic() - last_save > 15 or grew:
            save(); last_save = time.monotonic()
        time.sleep(POLL)

    if reason:
        freeze_evidence(paths, pgid, proc.pid, st)
        st["kill"] = kill_group(pgid, proc.pid)
        rc = st["kill"].pop("main_rc", None)
        if rc is None:
            try:
                p, s = os.waitpid(proc.pid, 0)
                rc = os.waitstatus_to_exitcode(s)
            except ChildProcessError:
                pass
        st["state"] = reason
    else:
        # finished on its own; read the remaining events
        for ln in ev_tail.new_lines() + ([ev_tail.buf] if ev_tail.buf else []):
            an.rec(ln, "events")
        for ln in hk_tail.new_lines():
            an.rec(ln, "hooks")
        an.codex_reconcile(end=True)
        for ln in err_tail.new_lines() + ([err_tail.buf] if err_tail.buf else []):
            stderr_alert(an, a, ln)
        if info.get("reply_file") and os.path.isfile(info["reply_file"]):
            try:
                with open(info["reply_file"], errors="replace") as f:
                    conv.add("final", f.read(200_000))
            except OSError:
                pass
        elif an.last_msg and not conv.final:
            conv.add("final", an.last_msg)
        st["alerts"] = an.alerts
        st["stats"].update(turns=an.turn_count, tool_calls=an.calls, files_edited=len(an.files))
        # anything left in the group (background server etc.)? kill it and record it
        alive_pids, _ = V.members(pgid, [proc.pid])
        if alive_pids:
            st["kill"] = kill_group(pgid, proc.pid)
            st["kill"].pop("main_rc", None)
            st["kill"]["reason"] = "leftovers after the command ended"
        else:
            st["kill"] = verify(pgid, proc.pid)
        if rc == 0:
            st["state"] = "done"
        elif rc is not None and rc < 0:
            st["state"] = "killed"
            st["summary"] = f"command killed by signal {-rc} (outside Vigia)"
        else:
            st["state"] = "failed"
        if an.result and an.result.get("is_error") and st["state"] == "done":
            st["state"] = "failed"
    st["exit_code"] = rc
    st["ended_at"] = V.now_iso()
    st["duration_sec"] = int(time.time() - w0)       # wall clock
    st["active_sec"] = int(time.monotonic() - t0)    # only the time the box was awake
    if not reason and a.max_min and time.time() - w0 > a.max_min * 60:
        al = f"finished after the cap: {int((time.time() - w0) // 60)} min of wall clock > max-min {a.max_min:g}"
        if al not in an.alerts:
            an.alerts.append(al)
        st["alerts"] = an.alerts
    incomplete = lead_without_summary(a, w0) if st["state"] == "done" else None
    if an.result:
        r = an.result
        st["result"] = {k: r.get(k) for k in ("subtype", "is_error", "num_turns", "total_cost_usd", "duration_ms") if k in r}
        usage = st.setdefault("usage", {})
        if isinstance(r.get("usage"), dict):
            usage.update(r["usage"])
        for k in ("input_tokens", "output_tokens", "total_tokens"):
            if k in r:
                usage[k] = r[k]
    # Claude subscription limit → explicit state (no silent loop)
    blob = " ".join([
        st.get("summary") or "",
        " ".join(st.get("alerts") or []),
        str(an.last_error or ""),
        str((an.result or {}).get("result") or "")[-2000:],   # the limit can be the final result (stdout, exit 0)
        str(an.last_msg or "")[-2000:],
    ])
    try:
        with open(paths["stderr"], errors="replace") as _ef:
            blob += " " + _ef.read()[-2000:]
    except OSError:
        pass
    lim = V.detect_claude_limit(blob) if a.tool == "claude" else None   # a Codex run echoes text: no false hits
    if lim:
        st["limit"] = lim
        role = V.LimitFallback.role_of(a.role, a.task_dir, a.name)
        fb = dict(V.limit_fallback_plan(role))
        fb["role"] = role
        if fb["action"] == "fallback_tool":
            fb["pending"] = True          # launched by run_supervisor once this run has left active/
            fb["prior_state"] = st.get("state")
            st["state"] = "limit_handoff"  # not terminal: waiters keep waiting until the relaunch is decided
        else:
            try:
                fb["resume_file"] = V.LimitFallback.resume_file(a.task_dir, name=a.name, role=role,
                                                                resets=lim.get("resets"),
                                                                relaunch_argv=st.get("relaunch_argv"))
            except OSError as e:
                fb["resume_error"] = str(e)
        st["limit_fallback"] = fb
        if fb["action"] == "pause" and st.get("state") in ("done", "failed", "running"):
            st["state"] = "limit_paused"
        st["summary"] = (fb["summary"] + (f" (resets {lim.get('resets')})" if lim.get("resets") else "")
                         + " | " + (st.get("summary") or ""))[:500]
        usage = dict(st.get("usage") or {})
        usage.update({k: st.get("result", {}).get(k) for k in ("total_cost_usd", "num_turns", "duration_ms") if st.get("result")})
        usage["role"] = role
        V.append_usage_progress(a.task_dir, name=a.name, tool=a.tool, model=st.get("model"),
                                usage=usage, limit_info=lim)
    elif st.get("state") in ("done", "failed", "incomplete", "timeout", "loop", "killed") and a.task_dir:
        usage = dict(st.get("usage") or {})
        if st.get("result"):
            usage.update({k: st["result"].get(k) for k in ("total_cost_usd", "num_turns", "duration_ms") if k in st["result"]})
        V.append_usage_progress(a.task_dir, name=a.name, tool=a.tool, model=st.get("model"), usage=usage)

    if not st["summary"]:
        base = an.last_msg or an.last_error or ""
        if not base:
            try:
                with open(paths["stderr"], errors="replace") as f:
                    base = f.read()[-300:]
            except OSError:
                pass
        st["summary"] = re.sub(r"\s+", " ", str(base)).strip()[:300]
    if st["alerts"]:
        st["summary"] = (st["summary"] + " | ALERT: " + "; ".join(st["alerts"][:3]))[:500]
    if incomplete and st.get("state") == "limit_paused":
        incomplete = None   # the limit explains the missing summary: keep the resumable state, not 'incomplete'
    if incomplete:
        st["state"] = "incomplete"
        st["incomplete_reason"] = incomplete
        st["summary"] = "INCOMPLETE: " + incomplete + " | " + (st["summary"] or "")
    st["summary"] = re.sub(r"\s+", " ", st["summary"] or "").strip()[:500]
    if not save():
        # the watchdog ended this run while the supervisor was not watching: wait for it to record the kill (up to
        # 60 awake seconds) so 'finished' goes out complete, and return its status without overwriting it
        end = time.monotonic() + 60
        while time.monotonic() < end and not isinstance((V.read_json(paths["status"]) or {}).get("kill"), dict):
            time.sleep(0.5)
        return V.read_json(paths["status"]) or st
    for al in an.alerts:  # alerts that only showed up at the end (stderr, cap)
        if al not in alerts_sent:
            alerts_sent.add(al)
            notify("alert", "running", "running", al, "alert|" + V.h(al))
    if incomplete:
        notify("detected", "incomplete", "running", "incomplete: " + incomplete, "detected|incomplete")
    return st


def stderr_alert(an, a, ln):
    if V.STDERR_ALERT_RE.search(ln or "") or (a.tool == "claude" and V.ALERT_RE.search(ln or "")):
        m = "stderr: " + re.sub(r"\s+", " ", ln).strip()[:200]
        if m not in an.alerts and len(an.alerts) < 12:
            an.alerts.append(m)


def lead_without_summary(a, start_wall):
    """Fleet lead (name fleet-*-lead-*) that exited without leaving this run's T/FINAL-SUMMARY.md: reason, else None."""
    if not V.LEAD_RE.fullmatch(a.name):
        return None
    f = os.path.join(a.task_dir, "FINAL-SUMMARY.md")
    try:
        if os.path.getsize(f) > 0 and os.path.getmtime(f) >= start_wall - 2:
            return None
        return "fleet lead exited without a fresh T/FINAL-SUMMARY.md (the existing one predates this run or is empty)"
    except OSError:
        return "fleet lead exited without writing T/FINAL-SUMMARY.md"


def verify(pgid, pid):
    out = subprocess.run(["pgrep", "-g", str(pgid)], capture_output=True, text=True)
    alive_pids, _ = V.members(pgid, [pid])
    return {"pgrep_g": out.stdout.split(), "pgrep_rc": out.returncode, "survivors": sorted(alive_pids),
            "ok": out.returncode == 1 and not alive_pids, "verified_at": V.now_iso()}


def kill_group(pgid, pid):
    log = {"term_at": V.now_iso(), "kill_sent": False}
    alive_pids, _ = V.members(pgid, [pid])
    log["targets"] = sorted(alive_pids)
    try:
        os.killpg(pgid, signal.SIGTERM)
    except ProcessLookupError:
        pass
    for p in alive_pids:
        try:
            os.kill(p, signal.SIGTERM)
        except ProcessLookupError:
            pass
    end = time.monotonic() + KILL_GRACE
    while time.monotonic() < end:
        _collect(exclude=pid)
        alive_pids, _ = V.members(pgid, [pid])
        if not alive_pids:
            break
        time.sleep(0.5)
    if alive_pids:
        log["kill_sent"] = True
        try:
            os.killpg(pgid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        for p in alive_pids:
            try:
                os.kill(p, signal.SIGKILL)
            except ProcessLookupError:
                pass
        time.sleep(1)
    _collect(exclude=pid)
    # reap the main child here (keeping its exit code) so its zombie does not show up in pgrep
    for _ in range(20):
        try:
            p, s = os.waitpid(pid, os.WNOHANG)
        except ChildProcessError:
            break
        if p == pid:
            log["main_rc"] = os.waitstatus_to_exitcode(s)
            break
        time.sleep(0.25)
    time.sleep(0.3)
    log.update(verify(pgid, pid))
    return log


def _collect(exclude=None):
    # reap orphaned zombies, but leave the main child to the waitpid that collects its exit code
    for p, s in list(V.all_procs().items()):
        if s["state"] == "Z" and s["ppid"] == os.getpid() and p != exclude:
            try:
                os.waitpid(p, os.WNOHANG)
            except ChildProcessError:
                pass


def freeze_evidence(paths, pgid, pid, st):
    d = paths["evidence"]
    os.makedirs(d, exist_ok=True)
    def tail(src, dst, n=200_000):
        try:
            with open(src, "rb") as f:
                f.seek(0, 2); size = f.tell(); f.seek(max(0, size - n))
                data = f.read()
            with open(os.path.join(d, dst), "wb") as g:
                g.write(data)
        except OSError:
            pass
    tail(paths["events"], "events.tail.jsonl")
    tail(paths["stderr"], "stderr.tail.log")
    tail(paths["hooks"], "hooks.tail.jsonl")
    alive_pids, procs = V.members(pgid, [pid])
    ps = subprocess.run(["ps", "-o", "pid,ppid,pgid,sid,stat,etime,time,args", "--forest", "-p",
                         ",".join(map(str, sorted(alive_pids))) or str(pid)], capture_output=True, text=True).stdout
    with open(os.path.join(d, "ps.txt"), "w") as f:
        f.write(f"# captured at {V.now_iso()} pgid={pgid}\n{ps}")
    V.write_json_atomic(os.path.join(d, "status-at-capture.json"), C.redact_obj(st))


# ======================= main / detach =======================

def main():
    a = parse()
    exe = a.cmd[0]
    search_path = os.environ.get("PATH", "") + ":" + os.path.expanduser("~/.local/bin")
    if not (os.path.isabs(exe) and os.access(exe, os.X_OK)) and not shutil.which(exe, path=search_path):
        fail(f"command not found: {exe}", 5)
    runs = os.path.join(a.task_dir, "runs")
    os.makedirs(runs, exist_ok=True)
    b = os.path.join(runs, a.name)
    paths = {"status": b + ".status.json", "events": b + ".events.jsonl", "stderr": b + ".stderr.log",
             "hooks": b + ".hooks.jsonl", "evidence": b + ".evidence", "supervisor_log": b + ".vigia.log",
             "prompt": b + ".prompt.md", "conversation": b + ".conversation.md"}
    key = V.h(a.task_dir, a.name)
    entry = os.path.join(V.ACTIVE_DIR, f"{a.name}-{key}.json")

    try:
        V.watch_active()  # cheap watchdog: runs whose supervisor stopped watching / went past the cap
    except Exception as e:
        print(f"vigia-run: watchdog failed: {e}", file=sys.stderr)
    with V.Lock():
        V.cleanup_dead()
        active = V.active_entries()
        if os.path.exists(paths["status"]) or os.path.exists(entry):
            fail(f"a run named '{a.name}' already exists in {runs} (status: {paths['status']}). Use another --name.", 4)
        if len(active) >= V.MAX_ACTIVE:
            names = ", ".join(e.get("name", "?") for e in active)
            fail(f"cap of {V.MAX_ACTIVE} active supervised runs reached ({names}). "
                 f"Wait for one to finish or stop one with vigia-stop.", 3)
        for k in ("events", "stderr", "hooks"):
            open(paths[k], "a").close()

        if a.foreground:
            sup_pid = os.getpid()
            V.write_json_atomic(entry, _entry(a, paths, key, sup_pid))
        else:
            r, w = os.pipe()
            pid1 = os.fork()
            if pid1 == 0:
                os.close(r)
                os.setsid()
                if os.fork() > 0:
                    os._exit(0)
                # grandchild: the detached supervisor
                os.write(w, str(os.getpid()).encode()); os.close(w)
                devnull = os.open(os.devnull, os.O_RDWR)
                log = os.open(paths["supervisor_log"], os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o644)
                os.dup2(devnull, 0); os.dup2(log, 1); os.dup2(log, 2)
                # close inherited fds (including the lock's)
                os.closerange(3, 1024)
                os.chdir("/")
                run_supervisor(a, paths, key, entry)
                os._exit(0)
            os.close(w)
            os.waitpid(pid1, 0)
            sup_pid = int(os.read(r, 32).decode() or 0)
            os.close(r)
            V.write_json_atomic(entry, _entry(a, paths, key, sup_pid))

    if a.foreground:
        st = run_supervisor(a, paths, key, entry)
        print(json.dumps({"name": a.name, "state": st["state"], "status_path": paths["status"],
                          "prompt_path": paths["prompt"], "conversation_path": paths["conversation"]}, ensure_ascii=False))
        return
    # wait for the supervisor to record the command's pid (up to 10s) so we can return something useful
    st = None
    for _ in range(100):
        st = V.read_json(paths["status"])
        if st and st.get("pid"):
            break
        time.sleep(0.1)
    print(json.dumps({"name": a.name, "tool": a.tool, "state": (st or {}).get("state", "starting"),
                      "supervisor_pid": sup_pid, "pid": (st or {}).get("pid"), "pgid": (st or {}).get("pgid"),
                      "task": a.task, "model": (st or {}).get("model"),
                      "status_path": paths["status"], "events_path": paths["events"],
                      "prompt_path": paths["prompt"], "conversation_path": paths["conversation"]}, ensure_ascii=False))


def _entry(a, paths, key, sup_pid):
    s = V.proc_stat(sup_pid) or {}
    return {"name": a.name, "key": key, "tool": a.tool, "task_dir": a.task_dir,
            "status_path": paths["status"], "supervisor_pid": sup_pid, "supervisor_start": s.get("start"),
            "registered_at": V.now_iso()}


def webhook_env_from_environ():
    """VIGIA_WEBHOOK_ENV from the environment (absolute path), "" if empty (= no webhook), None if unset (= default)."""
    v = os.environ.get("VIGIA_WEBHOOK_ENV")
    if v is None:
        return None
    v = v.strip()
    return os.path.abspath(os.path.expanduser(v)) if v else ""


def relaunch_argv_from_environ():
    """ORQ_RELAUNCH_ARGV (JSON list) = the launcher command line that started this run (e.g. fleet-run)."""
    try:
        v = json.loads(os.environ.get("ORQ_RELAUNCH_ARGV") or "null")
    except ValueError:
        return None
    return [str(x) for x in v] if isinstance(v, list) and v else None


def run_supervisor(a, paths, key, entry):
    st = None
    notifier = None
    script = os.path.join(V.BIN, "vigia-notify")
    try:
        try:
            notifier = C.Notifier(script, paths["status"])
        except Exception as e:
            print(f"notifier did not start: {e}", file=sys.stderr)
        st = supervise(a, paths, key, notifier)
    except BaseException as e:
        import traceback
        traceback.print_exc()
        try:
            st = V.read_json(paths["status"]) or {"name": a.name, "tool": a.tool, "task_dir": a.task_dir, "task": a.task,
                                                  "paths": paths, "prompt_path": paths["prompt"]}
            if st.get("watchdog"):
                raise RuntimeError("the watchdog already ended the run")  # do not overwrite
            if st.get("pgid") and st.get("state") == "running":
                st["kill"] = kill_group(st["pgid"], st.get("pid"))
            st.update(state="failed", ended_at=V.now_iso(), summary=C.redact(f"internal Vigia error: {e}"))
            V.write_json_atomic(paths["status"], C.redact_obj(st))
        except Exception:
            traceback.print_exc()
    finally:
        try:
            with V.Lock():
                try:
                    os.unlink(entry)
                except FileNotFoundError:
                    pass
        except Exception:
            pass
        # Claude limit on a review: relaunch it on Codex now that this run left active/
        try:
            fb = (st or {}).get("limit_fallback") or {}
            if fb.get("pending"):
                fleet_bin = os.environ.get("FLEET_BIN") or os.path.join(os.path.dirname(V.BIN), "fleet", "bin")
                fb.pop("pending")
                fb["relaunch"] = V.LimitFallback.launch_codex_review(st, fleet_bin=fleet_bin)
                with V.run_lock(paths["status"]):
                    cur = V.read_json(paths["status"]) or st
                    cur["limit_fallback"] = fb
                    if fb["relaunch"].get("launched"):
                        cur["state"] = "limit_fallback"
                        cur["fallback_status_path"] = fb["relaunch"].get("status_path")
                        cur["summary"] = (f"Claude limit: review relaunched on Codex as {fb['relaunch']['name']} | "
                                          + (cur.get("summary") or ""))[:500]
                    else:
                        cur["state"] = fb.get("prior_state") or "failed"
                        cur["summary"] = (f"Claude limit: Codex fallback FAILED to launch "
                                          f"({fb['relaunch'].get('error', '?')[:160]}) | " + (cur.get("summary") or ""))[:500]
                    V.write_json_atomic(paths["status"], C.redact_obj(cur))
                    st = cur
        except Exception as e:
            print(f"limit fallback failed: {e}", file=sys.stderr)
        # end notification: exactly one (vigia-notify also dedupes per run), after pending notifications
        try:
            if notifier is not None:
                notifier.drain(60)
            final = (st or {}).get("state") or "failed"
            subprocess.run([script, paths["status"], "--event", "finished", "--state", str(final), "--prev", "running"],
                           timeout=90, stdin=subprocess.DEVNULL)
        except Exception as e:
            print(f"vigia-notify failed: {e}", file=sys.stderr)
    return st


if __name__ == "__main__":
    main()
