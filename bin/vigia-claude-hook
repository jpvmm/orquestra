#!/usr/bin/env python3
"""Claude Code hook (enabled per run via `--settings $ORQUESTRA_HOME/bin/claude-hooks.json`).
Reads the hook event JSON on stdin and appends a short line to $VIGIA_HEARTBEAT (set by vigia-run).
Outside Vigia (no VIGIA_HEARTBEAT) it does nothing. Never prints to stdout and always exits 0,
except: with VIGIA_PROTECT_TESTS=1 it denies (PreToolUse) edits to test files."""
import hashlib, json, os, re, sys
from datetime import datetime
from zoneinfo import ZoneInfo

TESTE_RE = re.compile(r"(^|/)(tests?|__tests__|spec)/|(^|/)test_[^/]*$|(^|/)[^/]*_test\.[^/]+$|\.spec\.[^/]+$|\.test\.[^/]+$|(^|/)conftest\.py$")
EDIT = ("Edit", "Write", "MultiEdit", "NotebookEdit")
DENY_MSG = "Test file protected by Vigia: do not edit tests in this task."


def agora_iso():
    tz = os.environ.get("VIGIA_TZ")
    d = datetime.now(ZoneInfo(tz)) if tz else datetime.now().astimezone()
    return d.isoformat(timespec="seconds")


def main():
    alvo = os.environ.get("VIGIA_HEARTBEAT")
    try:
        ev = json.load(sys.stdin)
    except Exception:
        return 0
    nome = ev.get("hook_event_name")
    tool = ev.get("tool_name")
    inp = ev.get("tool_input") or {}
    caminho = inp.get("file_path") or inp.get("notebook_path")
    negar = (nome == "PreToolUse" and tool in EDIT and os.environ.get("VIGIA_PROTECT_TESTS") == "1"
             and caminho and TESTE_RE.search(caminho))
    if alvo:
        linha = {"ts": agora_iso(), "hook_event_name": nome, "session_id": ev.get("session_id")}
        if tool:
            linha["tool_name"] = tool
            linha["tool_input"] = {k: (str(v)[:500]) for k, v in inp.items()
                                   if k in ("file_path", "notebook_path", "command", "pattern", "path", "url")}
            if tool in EDIT:
                linha["edit_sig"] = hashlib.sha1(json.dumps(inp, sort_keys=True).encode()).hexdigest()[:16]
        if nome == "PostToolUse" and tool == "Bash":
            resp = ev.get("tool_response")
            linha["output"] = (json.dumps(resp, ensure_ascii=False) if not isinstance(resp, str) else resp)[-1500:]
        if nome in ("PostToolUseFailure", "StopFailure"):
            linha["error"] = str(ev.get("error") or ev.get("error_message") or ev.get("tool_response") or "")[-1500:]
            linha["matcher"] = ev.get("error_type") or ev.get("matcher")
        if nome in ("Stop", "SubagentStop"):
            linha["agent_type"] = ev.get("agent_type")
            linha["last_message"] = str(ev.get("last_assistant_message") or "")[:300]
        if negar:
            linha["denied"] = True
            linha["path"] = caminho
        try:
            with open(alvo, "a") as f:
                f.write(json.dumps(linha, ensure_ascii=False) + "\n")
        except Exception:
            pass
    if negar:
        print(json.dumps({"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "deny",
                                                 "permissionDecisionReason": DENY_MSG}}))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception:
        sys.exit(0)
