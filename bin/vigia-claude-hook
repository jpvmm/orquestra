#!/usr/bin/env python3
"""Claude Code hook (enabled per run via `--settings $ORQUESTRA_HOME/bin/claude-hooks.json`).
Reads the hook event JSON on stdin and appends a short line to $VIGIA_HEARTBEAT (set by vigia-run).
Outside Vigia (no VIGIA_HEARTBEAT) it does nothing. Never prints to stdout and always exits 0,
except: it denies (PreToolUse) any read/write of secret files (.env, webhook.env); with VIGIA_PROTECT_TESTS=1 it denies (PreToolUse) edits and Bash writes to protected test files (the ones
that exist on the base, per fleet-run's snapshot; without it, any test) inside the run cwd/task dir. Rule: HookPolicy."""
import hashlib, json, os, sys
from datetime import datetime
from zoneinfo import ZoneInfo

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from vigia_lib import HookPolicy
from vigia_comms import redact, redact_obj
EDIT = ("Edit", "Write", "MultiEdit", "NotebookEdit")


def now_iso():
    tz = os.environ.get("VIGIA_TZ")
    d = datetime.now(ZoneInfo(tz)) if tz else datetime.now().astimezone()
    return d.isoformat(timespec="seconds")


def main():
    target = os.environ.get("VIGIA_HEARTBEAT")
    try:
        ev = json.load(sys.stdin)
    except Exception:
        return 0
    name = ev.get("hook_event_name")
    tool = ev.get("tool_name")
    inp = ev.get("tool_input") or {}
    file_path = inp.get("file_path") or inp.get("notebook_path")
    deny = HookPolicy.deny_reason(name, tool, inp)
    if target:
        rec = {"ts": now_iso(), "hook_event_name": name, "session_id": ev.get("session_id")}
        if ev.get("agent_id"):   # tool call made by a subagent (not the run's own)
            rec["agent_id"] = ev.get("agent_id")
        if tool:
            rec["tool_name"] = tool
            rec["tool_input"] = {k: redact(str(v))[:500] for k, v in inp.items()
                                   if k in ("file_path", "notebook_path", "command", "pattern", "path", "url")}
            if tool in EDIT:
                rec["edit_sig"] = hashlib.sha1(json.dumps(inp, sort_keys=True).encode()).hexdigest()[:16]
        if name == "PostToolUse" and tool == "Bash":
            resp = ev.get("tool_response")
            rec["output"] = redact(json.dumps(redact_obj(resp), ensure_ascii=False) if not isinstance(resp, str) else resp)[-1500:]
        if name in ("PostToolUseFailure", "StopFailure"):
            rec["error"] = redact(str(redact_obj(ev.get("error") or ev.get("error_message") or ev.get("tool_response") or "")))[-1500:]
            rec["matcher"] = ev.get("error_type") or ev.get("matcher")
        if name in ("Stop", "SubagentStop"):
            rec["agent_type"] = ev.get("agent_type")
            rec["last_message"] = redact(str(ev.get("last_assistant_message") or ""))[:300]
        if deny:
            rec["denied"] = "secret" if deny == HookPolicy.SECRET else "test"
            rec["path"] = file_path or redact(str(inp.get("command") or ""))[:200]
        try:
            with open(target, "a") as f:
                f.write(json.dumps(redact_obj(rec), ensure_ascii=False) + "\n")
        except Exception:
            pass
    if deny:
        print(json.dumps({"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "deny",
                                                 "permissionDecisionReason": deny}}))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception:
        sys.exit(0)
