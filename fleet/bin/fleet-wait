#!/usr/bin/env python3
"""fleet-wait STATUS.json... [--max SEC]  — waits for Vigia runs to finish (default 540 s, fits one Bash call).
Prints one JSON per run: name, state, summary. Exits 0 if all finished, 2 if any is still running (call again)."""
import json, sys, time
TERMINAL = ("done", "failed", "stalled", "timeout", "loop", "killed", "incomplete", "limit_paused", "limit_fallback")
args = sys.argv[1:]
mx = 540.0
if "--max" in args:
    i = args.index("--max"); mx = float(args[i + 1]); del args[i:i + 2]
if not args or args[0] in ("-h", "--help"):
    print(__doc__); sys.exit(0 if args else 1)
end = time.time() + mx
while True:
    sts = []
    for p in args:
        try:
            with open(p) as f: sts.append(json.load(f))
        except (OSError, ValueError): sts.append({"name": p, "state": "?"})
    if all(s.get("state") in TERMINAL for s in sts) or time.time() >= end:
        break
    time.sleep(5)
for s in sts:
    print(json.dumps({"name": s.get("name"), "state": s.get("state"), "summary": (s.get("summary") or "")[:300]}, ensure_ascii=False))
sys.exit(0 if all(s.get("state") in TERMINAL for s in sts) else 2)
